# Release signing for RYOX VPN - opt-in, placeholders only.
#
# Copy this file to android/keystore.properties and replace every value. The
# copy is git-ignored (as is *.jks), so neither the keystore nor its passwords
# reach the repository. When android/keystore.properties is absent, the release
# build keeps the debug signing config and still assembles.
#
# Generate the key outside the repository once:
#   keytool -genkeypair -v -keystore release.jks -alias ryox -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is resolved relative to android/app/, so a keystore at the
# repository root is ../../release.jks. Use forward slashes: a properties file
# reads "\" as an escape character.

storeFile=../../release.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
