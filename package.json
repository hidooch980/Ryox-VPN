{
  "name": "ryox-vpn",
  "version": "1.0.0",
  "description": "RYOX VPN — Ultimate Free, Open Source Multi-Core VPN Client for Windows and Android",
  "main": "dist-electron/main/index.js",
  "author": "RYOX Network Team <dev@ryoxvpn.org>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/hidooch980/Ryox-VPN",
  "repository": {
    "type": "git",
    "url": "https://github.com/hidooch980/Ryox-VPN.git"
  },
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:cores": "node scripts/validate-core-configs.js",
    "android:assets": "node scripts/sync-android-assets.js",
    "setup:cores": "powershell -ExecutionPolicy Bypass -File scripts/setup-cores.ps1",
    "start": "electron ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.7"
  },
  "build": {
    "appId": "com.ryox.vpn",
    "productName": "RYOX VPN",
    "directories": {
      "output": "dist-packaged"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
